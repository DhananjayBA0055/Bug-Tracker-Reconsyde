# Prefer scripts/configure.py; do not use these placeholder values.
ADMIN_EMAIL=admin@bancapp.in
ADMIN_NAME=Bancapp Administrator
ADMIN_PASSWORD=replace-with-unique-password-at-least-12-characters
POSTGRES_PASSWORD=replace-with-generated-hex-password
COOKIE_SECURE=false
APP_PORT=8000
# Optional Docker HTTPS proxy; DNS must point at this host.
# APP_DOMAIN=tracker.yourcompany.com

# Generate once with Python: base64.urlsafe_b64encode(secrets.token_bytes(32)).decode()
SETTINGS_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
